#include "defs.dtsi"
#include "undef_rows.dtsi"

#define LEFT_TOP    &kp EQUAL  &kp MINUS   &kp MINUS    &kp LPAR     &kp LBRC      &kp LBKT  &tog NUMBER_LAYER
#define LEFT_UPPER  &kp LGUI   &kp SQT     &kp COMMA    &lt 1 DOT    &kp P         &kp Y     &none
#define LEFT_MIDDLE &kp LALT   &hm LGUI A  &hm LALT O   &hm LCTRL E  &hm LSHIFT U  &lt 2 I   &none               &mo 2      &kp LSHFT
#define LEFT_LOWER  &kp LCTRL  &kp SEMI    &kp Q        &kp J        &kp K         &kp X                         &kp LCTRL
#define LEFT_BOTTOM &mo 2      &kp GRAVE   &kp CAPS     &kp LEFT     &kp RIGHT                                   &kp BSPC   &kp ESC   &kp BSPC

#define RIGHT_TOP                                                &mo 3       &kp RBKT  &kp RBRC      &kp RPAR      &kp EQUAL    &kp N0       &kp MINUS
#define RIGHT_UPPER                                              &none       &kp F     &kp G         &kp C         &kp R        &kp L        &kp RGUI
#define RIGHT_MIDDLE &emacsMx     &kp RCTRL                      &none       &lt 2 D   &hm RSHIFT H  &hm RCTRL T   &hm RALT N   &hm RGUI S   &kp RALT
#define RIGHT_LOWER  &i3CmdNumber                                &kp B       &kp M     &kp W         &kp V         &kp Z        &kp RCTRL
#define RIGHT_BOTTOM &p RCTRL     &kp ENTER   &kp SPACE          &kp UP      &kp DOWN  &kp LBKT      &kp RBKT      &mo 2

#define layer0 \
        LEFT_TOP     RIGHT_TOP \
        LEFT_UPPER   RIGHT_UPPER \
        LEFT_MIDDLE  RIGHT_MIDDLE \
        LEFT_LOWER   RIGHT_LOWER \
        LEFT_BOTTOM  RIGHT_BOTTOM

